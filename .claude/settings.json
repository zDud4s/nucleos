{
  "sandbox": {
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "codex"
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python .ai/dashboard/serve.py)",
      "Bash(python .ai/dashboard/serve.py *)",
      "Bash(curl http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(codex exec * --dangerously-bypass-approvals-and-sandbox *)",
      "Bash(timeout * sh -c *codex exec*--dangerously-bypass-approvals-and-sandbox*)",
      "Bash(*codex exec*--dangerously-bypass-approvals-and-sandbox*)",
      "PowerShell(*codex exec*--dangerously-bypass-approvals-and-sandbox*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ask_daemon.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.ai/scripts/log_event.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.ai/scripts/evidence_gate.py\" --hook"
          }
        ]
      }
    ]
  }
}
