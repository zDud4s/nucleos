{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/tailwind.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/ui/vendor",
    "ui": "@/ui/vendor",
    "utils": "@/lib/cn",
    "lib": "@/lib",
    "hooks": "@/lib"
  },
  "registries": {
    "@bklit": "https://bklit.com/r/{name}.json",
    "@kokonutui": "https://kokonutui.com/r/{name}.json",
    "@21st": {
      "url": "https://21st.dev/r/{name}",
      "headers": {
        "Authorization": "Bearer ${TWENTYFIRST_API_KEY}"
      }
    }
  }
}
