{
  "build": {
    "beforeBuildCommand": "npm run build && npm run build:remote"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "resources": {
      "../dist-remote": "dist-remote"
    },
    "externalBin": [
      "binaries/nucleos-core",
      "binaries/nucleos-browser",
      "binaries/nucleos-echo",
      "binaries/nucleos-email",
      "binaries/nucleos-quota",
      "binaries/nucleos-remote",
      "binaries/nucleos-telegram",
      "binaries/nucleos-web"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}