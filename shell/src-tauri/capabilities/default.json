{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "vscode://file/*" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$LOCALDATA/nucleos/NucleOS/data/files/**" },
        { "path": "$LOCALDATA/dev.nucleos.NucleOS/files/**" },
        { "path": "$LOCALDATA/nucleos/files/**" }
      ]
    }
  ]
}
