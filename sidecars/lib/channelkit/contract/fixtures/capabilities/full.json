{ "missing": null,
  "hello": { "kind": "fake", "version": "1.0.0",
             "capabilities": { "buttons": true, "edit": true, "typing": true, "threads": true,
                               "reply_to": true, "max_text": 4096,
                               "media_in": ["audio", "image", "file"],
                               "media_out": ["image", "file", "audio"] } },
  "setup": { "identities": [ {"sender_ref": "4242", "conversation_ref": "4242", "home": true} ],
             "projects": { "nucleos": "-100123:7" },
             "media": [ {"id": "m_7", "name": "relatorio.pdf", "mime": "application/pdf"},
                        {"id": "m_8", "name": "grafico.png",   "mime": "image/png"},
                        {"id": "m_9", "name": "nota.ogg",      "mime": "audio/ogg"} ] },
  "steps": [
    { "core": {"do": "proposal_pending", "proposal_id": 12, "title": "Install ripgrep"},
      "expect": { "actions": [ { "type": "send", "conversation": "4242", "$present": ["buttons"],
                                 "parts": [ {"type": "text", "$not_contains": ["approve 12"]} ] } ] } },
    { "core": {"do": "feed_row", "project_id": "nucleos", "kind": "summary", "text": "Build finished"},
      "expect": { "actions": [ { "type": "send", "conversation": "-100123:7",
                                 "parts": [ {"type": "text", "$contains": ["Build finished"],
                                             "$not_contains": ["[nucleos]"]} ] } ] } },
    { "event": { "event_id": "full-1", "conversation": {"ref": "4242", "kind": "private"},
                 "sender": {"ref": "4242", "name": "Duarte"}, "type": "message",
                 "message": {"ref": "100", "parts": [ {"type": "text", "text": "Summarise the inbox"} ]} },
      "expect": { "response": {"accepted": true},
                  "actions": [ {"type": "send", "conversation": "4242"} ],
                  "ephemeral": [ {"type": "typing", "conversation": "4242"} ] } },
    { "core": {"do": "turn_finished", "stdout": "Inbox: 3 unread."},
      "expect": { "actions": [ { "type": "edit", "conversation": "4242",
                                 "parts": [ {"type": "text", "$contains": ["finished"]} ] },
                               { "type": "send", "conversation": "4242",
                                 "parts": [ {"type": "text", "$contains": ["Inbox: 3 unread."]} ] } ] } },
    { "core": {"do": "capture_requested", "capture": 3, "summary": "Which option, A or B?"},
      "expect": { "actions": [ { "type": "send", "conversation": "4242",
                                 "parts": [ {"type": "text", "$not_contains": ["/cap 3"]} ] } ] } },
    { "core": {"do": "send_parts", "conversation": "4242",
               "parts": [ {"type": "text", "text": "Here is the report"},
                          {"type": "image", "media": "m_8"},
                          {"type": "file",  "media": "m_7", "name": "relatorio.pdf"},
                          {"type": "audio", "media": "m_9"} ]},
      "expect": { "actions": [ { "type": "send", "conversation": "4242",
                                 "parts": [ {"type": "text", "text": "Here is the report"},
                                            {"type": "image", "media": "m_8"},
                                            {"type": "file",  "media": "m_7"},
                                            {"type": "audio", "media": "m_9"} ] } ] } } ] }
