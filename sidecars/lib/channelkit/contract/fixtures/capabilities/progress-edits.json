{ "missing": null,
  "hello": { "kind": "fake", "version": "1.0.0",
             "capabilities": { "edit": true, "typing": true, "max_text": 4096 } },
  "setup": { "identities": [ {"sender_ref": "4242", "conversation_ref": "4242", "home": true} ] },
  "steps": [
    { "event": { "event_id": "prog-1", "conversation": {"ref": "4242", "kind": "private"},
                 "sender": {"ref": "4242", "name": "Duarte"}, "type": "message",
                 "message": {"ref": "100", "parts": [ {"type": "text", "text": "Summarise the inbox"} ]} },
      "expect": { "response": {"accepted": true},
                  "actions": [ {"type": "send", "conversation": "4242", "$absent": ["target"]} ],
                  "ephemeral": [ {"type": "typing", "conversation": "4242"} ] } },
    { "core": {"do": "stream_text", "text": "halfway there"},
      "expect": { "actions": [ { "type": "edit", "conversation": "4242", "$present": ["target"],
                                 "parts": [ {"type": "text", "$contains": ["halfway there"]} ] } ] } },
    { "core": {"do": "stream_text", "text": "almost done"},
      "expect": { "actions": [ { "type": "edit", "conversation": "4242", "$present": ["target"],
                                 "parts": [ {"type": "text", "$contains": ["almost done"]} ] } ] } },
    { "core": {"do": "turn_finished", "stdout": "Inbox: 3 unread."},
      "expect": { "actions": [ { "type": "edit", "conversation": "4242", "$present": ["target"],
                                 "parts": [ {"type": "text", "$contains": ["finished"]} ] },
                               { "type": "send", "conversation": "4242",
                                 "parts": [ {"type": "text", "$contains": ["Inbox: 3 unread."]} ] } ] } } ] }
