# gawk reads its program file verbatim; a CR at the end of a source line lands
# inside string literals and regexes. The repo-root .gitattributes pins *.sh to
# LF for the same reason but does not know about these, and this machine has
# core.autocrlf=true, so a fresh checkout would hand gawk CRLF sources.
*.awk text eol=lf

# The task table is split on tabs; a trailing CR would ride along on the last
# field of every row.
*.tsv text eol=lf

# A base patch is applied to a tree checked out on this machine, where
# core.autocrlf=true. `git apply` matches context lines literally, so a patch
# that arrived as CRLF while the tree it patches is CRLF-on-disk-but-LF-in-git
# fails on every hunk. Pin it, and the one thing that must not vary stops
# varying.
bases/*.patch text eol=lf
